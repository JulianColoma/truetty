    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vite": "^6.3.5",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "qrcode": "^1.5.4",
