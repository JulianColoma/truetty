{
  "name": "keypass-auth",
  "version": "2.0.0",
  "description": "MVP v2 - KeyPass Auth con WebSocket, QR real y verificación end-to-end",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:frontend": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:frontend": "vite build",
